# OLMOCR / IQ-RAG Workstation Configuration
# Copy this file to .env and fill in the values

# Hugging Face Token (required for gated models like Phi-4, olmOCR-2-7B-1025-FP8)
HF_TOKEN=

# --- PostgreSQL Configuration ---
OLMOCR_PG_HOST=localhost
OLMOCR_PG_PORT=5432
OLMOCR_PG_DB=olmocr_rag
OLMOCR_PG_USER=olmocr
# Set a secure password. Must match POSTGRES_PASSWORD in docker-compose.rag.yml
OLMOCR_PG_PASS=pg_pass_5c6d3284f18b90a6e2d8

# --- Redis Configuration ---
OLMOCR_REDIS_HOST=localhost
OLMOCR_REDIS_PORT=6379
OLMOCR_REDIS_DB=0

# --- MinIO Object Storage Configuration ---
OLMOCR_MINIO_ENDPOINT=localhost:9000
OLMOCR_MINIO_ACCESS_KEY=olmocr_minio
# Set a secure secret key. Must match MINIO_ROOT_PASSWORD in docker-compose.rag.yml
OLMOCR_MINIO_SECRET_KEY=minio_secret_8a92f03b5d1e4c7678ab
OLMOCR_MINIO_SECURE=false

# --- Embedding & Reranking Settings ---
OLMOCR_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
OLMOCR_EMBEDDING_DEVICE=cpu
