# OLMOCR / IQ-RAG Workstation Configuration
# Copy this file to .env and fill in the values

# Hugging Face Token (required for gated models like Phi-4, olmOCR-2-7B-1025-FP8)
HF_TOKEN=

# --- PostgreSQL Configuration ---
OLMOCR_PG_HOST=localhost
OLMOCR_PG_PORT=5432
OLMOCR_PG_DB=olmocr_rag
OLMOCR_PG_USER=olmocr
# IMPORTANT: Set a STRONG, unique password. This MUST match POSTGRES_PASSWORD in
# docker-compose.rag.yml (use ${OLMOCR_PG_PASS} there). Never commit a real
# password to version control.
OLMOCR_PG_PASS=change_me_in_production

# --- Redis Configuration ---
OLMOCR_REDIS_HOST=localhost
OLMOCR_REDIS_PORT=6379
OLMOCR_REDIS_DB=0

# --- MinIO Object Storage Configuration ---
OLMOCR_MINIO_ENDPOINT=localhost:9000
OLMOCR_MINIO_ACCESS_KEY=change_me_minio_user
# IMPORTANT: Set a STRONG, unique secret. This MUST match MINIO_ROOT_PASSWORD in
# docker-compose.rag.yml (use ${OLMOCR_MINIO_SECRET_KEY} there). Never commit a
# real secret to version control.
OLMOCR_MINIO_SECRET_KEY=change_me_minio_secret
OLMOCR_MINIO_SECURE=false

# --- vLLM inference container security ---
# Images MUST use an immutable repository@sha256:<digest> reference.
OLMOCR_VLLM_IMAGE=vllm/vllm-openai@sha256:04563c302537a91aa49ebdfbceda96111c5712275999b7e8804fa598f0b5641d
# Production inference is resolved by immutable model revision and starts in
# offline mode. Prepare this snapshot before starting the systemd services.
KIRAG_HF_HOME=/home/kirag/KIRAG/workspace/huggingface
# OCR and analysis retain distinct host ports, but the guarded lifecycle runs
# exactly one model in the single `kirag_vllm` container at a time.
KIRAG_OCR_MODEL=allenai/olmOCR-2-7B-1025-FP8
KIRAG_OCR_MODEL_REVISION=replace_with_40_character_ocr_model_commit_sha
KIRAG_OCR_SERVER_URL=http://127.0.0.1:8000/v1
KIRAG_OCR_VLLM_PORT=8000
KIRAG_OCR_GPU_MEMORY_UTILIZATION=0.85
KIRAG_OCR_MAX_MODEL_LEN=15360
KIRAG_OCR_MAX_BATCHED_TOKENS=4096
KIRAG_ANALYSIS_MODEL=Qwen/Qwen3.6-35B-A3B
KIRAG_ANALYSIS_MODEL_REVISION=replace_with_40_character_analysis_model_commit_sha
# Verified interchangeable analysis profiles:
# Qwen/Qwen3.6-35B-A3B @ 995ad96eacd98c81ed38be0c5b274b04031597b0
# google/gemma-4-31B-it @ 842da3794eaa0b77d5f08bae87a17459d91ff475
KIRAG_ANALYSIS_SERVER_URL=http://127.0.0.1:8002/v1
KIRAG_ANALYSIS_VLLM_PORT=8002
KIRAG_ANALYSIS_GPU_MEMORY_UTILIZATION=0.85
KIRAG_ANALYSIS_MAX_MODEL_LEN=262144
KIRAG_ANALYSIS_MAX_BATCHED_TOKENS=8192
KIRAG_VLLM_TENSOR_PARALLEL_SIZE=1
KIRAG_VLLM_SHM_SIZE=8gb
KIRAG_VLLM_STOP_TIMEOUT=120s
KIRAG_VLLM_HEALTH_START_PERIOD=30m
# Fail-closed defaults. These may only be enabled by an administrator.
KIRAG_ADVANCED_MODEL_OVERRIDE=false
KIRAG_ENABLE_REMOTE_CODE=false
# When remote code is enabled, this must name a dedicated internal Docker
# network labeled com.kirag.remote-code=true. For example:
# docker network create --internal --label com.kirag.remote-code=true kirag-remote-code
# Built-in and namespace-sharing modes are refused.
KIRAG_REMOTE_CODE_NETWORK=
# Use a dedicated scoped, short-lived token; do not reuse the general HF_TOKEN.
KIRAG_REMOTE_CODE_HF_TOKEN=
KIRAG_REMOTE_CODE_SHM_SIZE=8g
# Structured lifecycle/model deletion events are written here (optional override).
KIRAG_AUDIT_LOG=
KIRAG_LOG_DIR=/home/kirag/KIRAG/logs
KIRAG_LOG_LEVEL=INFO
KIRAG_LOG_MAX_BYTES=20971520
KIRAG_LOG_BACKUP_COUNT=5
KIRAG_LLM_MAX_ATTEMPTS=3
KIRAG_LLM_CIRCUIT_THRESHOLD=5
KIRAG_LLM_CIRCUIT_RECOVERY_SECONDS=30
# Fast chronology relies on vLLM continuous batching to meet its interactive
# runtime target. Lower this only if the analysis server reports overload/OOM.
KIRAG_FAST_TIMELINE_CONCURRENCY=20

# --- Network exposure & API Security ---
# This workstation handles medicolegal PII. The Gradio app (port 7860), vLLM
# (8000, bound to 127.0.0.1 only), and the backing services (Postgres 5432,
# Redis 6379, MinIO 9000/9001, Qdrant 6333/6334) are NOT authenticated by default
# and must never be bound to a public interface.
#
# REST API authentication is fail-closed outside the public /health liveness check.
KIRAG_API_KEY=
# Required for destructive API operations (deletion, cleanup, shutdown, and forced indexing).
KIRAG_ADMIN_API_KEY=
# Disabled in supervised production: lifecycle is controlled through systemd.
KIRAG_ENABLE_REMOTE_LIFECYCLE=false
KIRAG_ENABLE_APP_SHUTDOWN=false
# Next.js server-side proxy destination. This is never exposed to browser bundles.
KIRAG_API_URL=http://127.0.0.1:8001
# Persist mutable settings beneath the production-writable workspace. Interactive
# installs may omit this and continue using the checkout-level settings.json.
KIRAG_SETTINGS_FILE=
# Both values are required before KIRAG_GRADIO_HOST may be set to a non-loopback address.
KIRAG_GRADIO_USERNAME=
KIRAG_GRADIO_PASSWORD=

# Restricted CORS origins (comma-separated). Defaults to local dev ports (3000, 5173, 7860).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:7860,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:7860

# Upload limits are enforced independently by the Next.js proxy and FastAPI.
KIRAG_MAX_PDF_FILES=20
KIRAG_MAX_PDF_FILE_BYTES=104857600
KIRAG_MAX_PDF_UPLOAD_BYTES=524288000
KIRAG_MAX_MARKDOWN_FILES=20
KIRAG_MAX_MARKDOWN_FILE_BYTES=10485760
KIRAG_MAX_MARKDOWN_UPLOAD_BYTES=52428800

OLMOCR_BIND_ADDRESS=127.0.0.1
