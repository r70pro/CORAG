# OLMOCR / IQ-RAG Workstation Configuration
# Copy this file to .env and fill in the values

# Hugging Face Token (required for gated models like Phi-4, olmOCR-2-7B-1025-FP8)
HF_TOKEN=

# --- PostgreSQL Configuration ---
OLMOCR_PG_HOST=localhost
OLMOCR_PG_PORT=5432
OLMOCR_PG_DB=olmocr_rag
OLMOCR_PG_USER=olmocr
# IMPORTANT: Set a STRONG, unique password. This MUST match POSTGRES_PASSWORD in
# docker-compose.rag.yml (use ${OLMOCR_PG_PASS} there). Never commit a real
# password to version control.
OLMOCR_PG_PASS=change_me_in_production

# --- Redis Configuration ---
OLMOCR_REDIS_HOST=localhost
OLMOCR_REDIS_PORT=6379
OLMOCR_REDIS_DB=0

# --- MinIO Object Storage Configuration ---
OLMOCR_MINIO_ENDPOINT=localhost:9000
OLMOCR_MINIO_ACCESS_KEY=change_me_minio_user
# IMPORTANT: Set a STRONG, unique secret. This MUST match MINIO_ROOT_PASSWORD in
# docker-compose.rag.yml (use ${OLMOCR_MINIO_SECRET_KEY} there). Never commit a
# real secret to version control.
OLMOCR_MINIO_SECRET_KEY=change_me_minio_secret
OLMOCR_MINIO_SECURE=false

# --- vLLM inference container image (optional override) ---
# Defaults to a pinned stable release. Set a CUDA-version-matched tag if needed.
OLMOCR_VLLM_IMAGE=nvcr.io/nvidia/vllm:26.05-py3

# --- Network exposure & API Security ---
# This workstation handles medicolegal PII. The Gradio app (port 7860), vLLM
# (8000, bound to 127.0.0.1 only), and the backing services (Postgres 5432,
# Redis 6379, MinIO 9000/9001, Qdrant 6333/6334) are NOT authenticated by default
# and must never be bound to a public interface.
#
# REST API Authentication: Set KIRAG_API_KEY to enforce X-API-Key / Bearer auth on REST API endpoints.
KIRAG_API_KEY=

# Restricted CORS origins (comma-separated). Defaults to local dev ports (3000, 5173, 7860).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:7860,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:7860

# Frontend API URL (optional, defaults to http://127.0.0.1:8001 if unset)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8001

OLMOCR_BIND_ADDRESS=127.0.0.1
