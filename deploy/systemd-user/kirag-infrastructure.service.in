[Unit]
Description=KIRAG containers and persistent infrastructure
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=@KIRAG_ROOT@
EnvironmentFile=@KIRAG_ENV@
ExecStartPre=/usr/bin/docker info
ExecStartPre=@KIRAG_ROOT@/.venv/bin/python @KIRAG_ROOT@/scripts/prepare-production-model.py ${KIRAG_OCR_MODEL} --revision ${KIRAG_OCR_MODEL_REVISION} --cache-dir ${KIRAG_HF_HOME} --offline-check
ExecStartPre=@KIRAG_ROOT@/.venv/bin/python @KIRAG_ROOT@/scripts/prepare-production-model.py ${KIRAG_ANALYSIS_MODEL} --revision ${KIRAG_ANALYSIS_MODEL_REVISION} --cache-dir ${KIRAG_HF_HOME} --offline-check
ExecStart=@KIRAG_ROOT@/.venv/bin/python @KIRAG_ROOT@/scripts/start-production-infrastructure.py
ExecReload=/usr/bin/docker compose --project-directory @KIRAG_ROOT@ -f @KIRAG_ROOT@/docker-compose.rag.yml -f @KIRAG_ROOT@/docker-compose.production.yml up --detach --wait --wait-timeout 3600
ExecStop=/usr/bin/docker compose --project-directory @KIRAG_ROOT@ -f @KIRAG_ROOT@/docker-compose.rag.yml -f @KIRAG_ROOT@/docker-compose.production.yml stop --timeout 120
TimeoutStartSec=3700
TimeoutStopSec=180

[Install]
WantedBy=default.target
