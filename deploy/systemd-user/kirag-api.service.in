[Unit]
Description=KIRAG FastAPI service
Wants=kirag-infrastructure.service
After=network-online.target

[Service]
Type=simple
RuntimeDirectory=kirag
RuntimeDirectoryMode=0700
WorkingDirectory=@KIRAG_ROOT@
EnvironmentFile=@KIRAG_ENV@
Environment=PYTHONUNBUFFERED=1
ExecStart=@KIRAG_ROOT@/.venv/bin/python -m uvicorn api.main:app --host 127.0.0.1 --port 8001 --workers 1 --limit-concurrency 100 --timeout-keep-alive 15 --timeout-graceful-shutdown 120 --no-access-log
Restart=on-failure
RestartSec=5s
TimeoutStopSec=150
KillSignal=SIGINT

[Install]
WantedBy=default.target
