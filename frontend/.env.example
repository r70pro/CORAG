# Server-only Next.js API proxy configuration.
# Copy to .env.local for development. Never add NEXT_PUBLIC_ to these names.
KIRAG_API_URL=http://127.0.0.1:8001
KIRAG_API_KEY=

# Required for frontend controls that call administrative API endpoints.
KIRAG_ADMIN_API_KEY=

# Keep these equal to the FastAPI process limits.
KIRAG_MAX_PDF_FILES=20
KIRAG_MAX_PDF_FILE_BYTES=104857600
KIRAG_MAX_PDF_UPLOAD_BYTES=524288000
KIRAG_MAX_MARKDOWN_FILES=20
KIRAG_MAX_MARKDOWN_FILE_BYTES=10485760
KIRAG_MAX_MARKDOWN_UPLOAD_BYTES=52428800
